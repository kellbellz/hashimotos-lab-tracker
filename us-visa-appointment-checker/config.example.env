# Copy to .env and fill in.  NEVER commit the real .env (it holds your password).

# --- Portal login ------------------------------------------------------------
VISA_EMAIL=you@example.com
VISA_PASSWORD=your-portal-password
# Login page. Verify against the live site — India moved from ustraveldocs.com
# to the usvisascheduling.com portal.
VISA_LOGIN_URL=https://www.usvisascheduling.com/en-US/
# Consular post to watch, exactly as labelled on the site:
# NEW DELHI | MUMBAI | CHENNAI | HYDERABAD | KOLKATA
VISA_LOCATION=NEW DELHI

# --- Date range you'll accept (inclusive, YYYY-MM-DD) ------------------------
VISA_DATE_FROM=2026-08-15
VISA_DATE_TO=2026-10-31

# --- Timing ------------------------------------------------------------------
VISA_INTERVAL_SECONDS=600   # 10 minutes
VISA_JITTER_SECONDS=90      # random extra 0-90s so checks aren't clockwork
VISA_HEADLESS=true          # set false the first time to log in / clear CAPTCHA

# --- Push notifications (pick at least one) ----------------------------------
# ntfy: no account. Choose a long random topic and subscribe in the ntfy phone app.
NTFY_TOPIC=usvisa-6f3a9c2b-change-me
NTFY_SERVER=https://ntfy.sh

# Pushover (optional alternative):
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
